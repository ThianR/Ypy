{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ypy.local/contracts/events/pos-operation.schema.json",
  "title": "Ypy POS operation",
  "type": "object",
  "required": ["operation_id", "empresa_id", "sucursal_id", "terminal_id", "cash_session_id", "sequence", "contract_version", "commercial_date", "currency", "total", "payments"],
  "properties": {
    "operation_id": {"type": "string", "format": "uuid"},
    "empresa_id": {"type": "string", "pattern": "^[0-9]+$"},
    "sucursal_id": {"type": "string", "pattern": "^[0-9]+$"},
    "terminal_id": {"type": "string", "pattern": "^[0-9]+$"},
    "cash_session_id": {"type": "string", "pattern": "^[0-9]+$"},
    "sequence": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "contract_version": {"type": "integer", "minimum": 1},
    "commercial_date": {"type": "string", "format": "date"},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "total": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "payments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["method", "currency", "amount"], "properties": {"method": {"type": "string"}, "currency": {"type": "string"}, "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"}}, "additionalProperties": false}},
    "queue_state": {"type": "string", "enum": ["PENDING", "SENDING", "APPLIED", "CONFLICT"]}
  },
  "additionalProperties": false
}
